{
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orderflow;Username=orderflow;Password=orderflow"
  },
  "Payments": {
    "CallbackUrl": "http://localhost:5080/api/webhooks",
    "Stripe": {
      "ApiKey": "",
      "BaseUrl": "https://api.stripe.com",
      "Currency": "brl",
      "SuccessUrl": "http://localhost:5080/payments/success",
      "CancelUrl": "http://localhost:5080/payments/cancel",
      "CardPaymentMethod": "pm_card_visa",
      "Enabled": true
    },
    "MercadoPago": {
      "AccessToken": "",
      "BaseUrl": "https://api.mercadopago.com",
      "NotificationUrl": "http://localhost:5080/api/webhooks/mercadopago",
      "StatementDescriptor": "ORDERFLOW",
      "Enabled": true
    },
    "Asaas": {
      "AccessKey": "",
      "BaseUrl": "https://api.asaas.com/v3",
      "DueDays": 3,
      "AutoCreateCustomer": true,
      "Enabled": true
    },
    "Simulated": {
      "AutoPayAfterSeconds": 15,
      "Enabled": true
    }
  },
  "IAppForms": {
    "Enabled": true,
    "ApiKey": "",
    "DefaultProvider": "",
    "ProviderPreferenceByMethod": {
      "Pix": [ "MercadoPago", "Asaas", "Stripe", "Simulated" ],
      "CreditCard": [ "Stripe", "Asaas", "MercadoPago", "Simulated" ],
      "DebitCard": [ "Stripe", "Asaas", "MercadoPago", "Simulated" ],
      "Boleto": [ "Asaas", "MercadoPago", "Simulated" ],
      "BankTransfer": [ "MercadoPago", "Simulated" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
